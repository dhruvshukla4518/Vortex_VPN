# ==============================================================================
# VORTEX VPN - Server Node WireGuard Configuration Template
# Interface: wg0
# ==============================================================================

[Interface]
# Server internal tunnel IPs (dual-stack)
Address = 10.8.0.1/24, fd42:42:42::1/64
ListenPort = 51820
PrivateKey = {{SERVER_PRIVATE_KEY}}

# Firewall NAT Masquerading & Packet Forwarding Rules
# Replace eth0 with your public network interface (e.g. ens3, eth0)
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE; ip6tables -A FORWARD -i wg0 -j ACCEPT; ip6tables -t nat -A POSTROUTING -o eth0 -j MASQUERADE; iptables -t nat -A PREROUTING -i wg0 -p udp --dport 53 -j REDIRECT --to-ports 5353
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE; ip6tables -D FORWARD -i wg0 -j ACCEPT; ip6tables -t nat -D POSTROUTING -o eth0 -j MASQUERADE; iptables -t nat -D PREROUTING -i wg0 -p udp --dport 53 -j REDIRECT --to-ports 5353

# Peers (Client devices dynamically appended by control plane)
# [Peer]
# PublicKey = {{CLIENT_PUBLIC_KEY}}
# AllowedIPs = 10.8.0.2/32, fd42:42:42::2/128
