# ==============================================================================
# VORTEX VPN - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default: Asynchronous SQLite for zero-config local development and testing.
# Production: postgresql+asyncpg://vortex_user:secure_password@localhost:5432/vortex_vpn
DATABASE_URL=sqlite+aiosqlite:///./vortex_vpn.db

# Redis Cache & Rate Limiting
# Optional for local dev (falls back to high-performance in-memory limiter)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
# Generate a cryptographically secure 256-bit key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=vortex-super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Agent Secret (Shared secret between control plane and remote server agents)
AGENT_SECRET_KEY=vortex-agent-node-secret-key-change-in-production

# WireGuard Internal Subnet Defaults
WIREGUARD_IPV4_SUBNET=10.8.0.0/24
WIREGUARD_IPV6_SUBNET=fd42:42:42::/64
WIREGUARD_DEFAULT_PORT=51820
WIREGUARD_DNS_SERVER=10.8.0.1

# DNS Blocker Engine
DNS_BIND_HOST=0.0.0.0
DNS_BIND_PORT=5353
DNS_UPSTREAM_PRIMARY=9.9.9.9
DNS_UPSTREAM_SECONDARY=1.1.1.1
DNS_CACHE_TTL_MIN=300
DNS_CACHE_MAX_ENTRIES=50000

# Blocklist Source URLs (Comma-separated)
BLOCKLIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts,https://adaway.org/hosts.txt

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Logging & Privacy
LOG_LEVEL=INFO
PRIVACY_STRICT_DATA_MINIMIZATION=true
AUDIT_LOG_RETENTION_DAYS=7
